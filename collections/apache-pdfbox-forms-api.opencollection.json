          "info": {
            "name": "Apache PDFBox Get Form Fields",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/pdfbox/documents/:documentId/forms",
            "params": [
              {
                "name": "documentId",
                "value": "doc-abc123",
                "type": "path",
                "description": "Document identifier"
              }
            ]
          },
          "docs": "Get all interactive form fields (AcroForm) from a PDF document."
        }
      ]
    }
  ],
  "bundled": true
